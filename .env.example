# Chiave API Anthropic (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL (Neon). Se assente, l'app usa i dati bundled (materiali + prodotti demo)
# e salva i piani in memoria (solo per sviluppo locale).
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# URL pubblico dell'app (per i link condivisibili dei piani)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Solo produzione (cron Vercel per l'aggiornamento del feed) ---
# URL del datafeed CSV Awin (disponibile dopo l'approvazione del programma Leroy Merlin IT)
# AWIN_FEED_URL=https://productdata.awin.com/datafeed/download/...
# Segreto per proteggere /api/cron/import-feed (Vercel lo invia come Bearer token)
# CRON_SECRET=una-stringa-casuale-lunga
